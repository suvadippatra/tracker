<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:gravity="center">

    <TextView
        android:id="@+id/overall_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overall Tracker"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/overall_net"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:text="Net: ₹ 0.0"
        android:textColor="#00FF66"
        android:textSize="16sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/overall_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overall_breakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        
        <TextView
            android:id="@+id/btn_add_meal"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="+ Meal"
            android:textColor="#000000"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_btn_accent_bg"
            android:gravity="center"
            android:text="+ Exp"
            android:textColor="#000000"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
